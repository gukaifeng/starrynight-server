# Copy to .env for a container-only local environment. Never use this public
# development password on a reachable production database.
POSTGRES_USER=starry
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=starry
DATABASE_URL=postgres://starry:local-development-only@127.0.0.1:55433/starry?sslmode=disable
REDIS_URL=redis://127.0.0.1:56380/0
STARRY_ENV=development
STARRY_LISTEN=127.0.0.1:18090
ALLOW_TEST_GUEST=true
DB_POOL_SIZE=16

# Optional private Python AI worker. This token is server-to-server only.
AI_UPSTREAM_URL=
AI_SERVICE_TOKEN=
# Optional private character storage. No OSS keys belong in an App or Git.
OSS_REGION=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_CREDENTIAL_SOURCE=ecs

# Admin-only BSS billing. If omitted, use the configured OSS credential provider.
# Assign docs/billing-readonly-policy.json to that RAM user/role before querying.
# Put actual values only in a private server environment file.
BILLING_ACCESS_KEY_ID=
BILLING_ACCESS_KEY_SECRET=
BILLING_SECURITY_TOKEN=
BILLING_BAILIAN_PRODUCT_CODE=sfm
