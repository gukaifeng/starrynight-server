[Unit]
Description=StarryNight control room
After=network-online.target starry-postgres.service starry-redis.service

[Service]
Type=simple
WorkingDirectory=%h/starrynight-server/current
EnvironmentFile=%h/app/config/platform.env
EnvironmentFile=%h/app/config/admin.env
ExecStart=%h/starrynight-server/current/bin/starry-admin
Restart=on-failure
RestartSec=5
UMask=0077
LimitNOFILE=2048
NoNewPrivileges=true

[Install]
WantedBy=default.target
